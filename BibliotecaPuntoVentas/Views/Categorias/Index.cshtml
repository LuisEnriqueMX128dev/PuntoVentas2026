@model List<BibliotecaPuntoVentas.ViewModels.Productos.CategoriaProductoViewModel>

@{
    ViewData["Title"] = "Categorías";
    ViewData["Subtitle"] = "Administra las categorías de tus productos";
}

<partial name="_Alertas" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Categorías</h2>
        <p class="text-secondary mb-0">Organiza los productos de tu negocio.</p>
    </div>

    <a asp-action="Crear" class="btn btn-nova-primary">
        + Nueva categoría
    </a>
</div>

<div class="nova-card">
    <header class="nova-card-header">
        <div>
            <h2>Listado de categorías</h2>
            <p>@Model.Count categoría(s) registrada(s)</p>
        </div>
    </header>

    <div class="table-responsive">
        <table class="table nova-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th class="text-center">Productos</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5">
                            <div class="nova-empty-state py-5">
                                No hay categorías registradas.
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var categoria in Model)
                    {
                        <tr>
                            <td>
                                <strong>@categoria.Nombre</strong>
                            </td>

                            <td>
                                <span class="text-secondary">
                                    @(string.IsNullOrWhiteSpace(categoria.Descripcion) ? "Sin descripción" : categoria.Descripcion)
                                </span>
                            </td>

                            <td class="text-center">
                                <span class="nova-pill">
                                    @categoria.TotalProductos
                                </span>
                            </td>

                            <td>
                                @if (categoria.Estatus)
                                {
                                    <span class="nova-status nova-status-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="nova-status nova-status-inactive">
                                        Inactiva
                                    </span>
                                }
                            </td>

                            <td>

                                <div class="d-flex justify-content-end gap-2">

                                    <a asp-action="Editar"
                                       asp-route-id="@categoria.Id"
                                       class="btn btn-sm btn-nova-secondary btn-accion-tabla">
                                        Editar
                                    </a>

                                    <form asp-action="CambiarEstatus" method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@categoria.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-accion-tabla @(categoria.Estatus ? "btn-outline-warning" : "btn-outline-success")">
                                            @(categoria.Estatus ? "Desactivar" : "Activar")
                                        </button>
                                    </form>

                                    @if (categoria.TotalProductos == 0)
                                    {
                                        <form asp-action="Eliminar"
                                              method="post"
                                              onsubmit="return confirm('¿Estás seguro de eliminar esta categoría?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@categoria.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger btn-accion-tabla">
                                                Eliminar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-accion-tabla"
                                                disabled
                                                title="No se puede eliminar porque tiene productos asociados">
                                            Eliminar
                                        </button>
                                    }

                                </div>
   
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>