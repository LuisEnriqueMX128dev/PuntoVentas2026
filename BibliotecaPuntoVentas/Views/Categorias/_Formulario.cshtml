@model BibliotecaPuntoVentas.ViewModels.Productos.CategoriaProductoFormularioViewModel

<input asp-for="Id" type="hidden" />

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="nova-card">
    <header class="nova-card-header">
        <div>
            <h2>Información de la categoría</h2>
            <p>Define cómo se agruparán tus productos.</p>
        </div>
    </header>

    <div class="nova-card-body">
        <div class="row g-4">

            <div class="col-12 col-md-6">
                <label asp-for="Nombre" class="form-label">
                    Nombre
                </label>

                <input asp-for="Nombre"
                       class="form-control nova-input"
                       placeholder="Ej. Bebidas" />

                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label d-block">
                    Estado
                </label>

                <div class="form-check form-switch mt-2">
                    <input asp-for="Estatus" class="form-check-input" />

                    <label asp-for="Estatus" class="form-check-label">
                        Categoría activa
                    </label>
                </div>
            </div>

            <div class="col-12">
                <label asp-for="Descripcion" class="form-label">
                    Descripción
                </label>

                <textarea asp-for="Descripcion"
                          rows="4"
                          class="form-control nova-input"
                          placeholder="Descripción opcional de la categoría"></textarea>

                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-action="Index" class="btn btn-nova-secondary">
        Cancelar
    </a>

    <button type="submit" class="btn btn-nova-primary">
        Guardar categoría
    </button>
</div>