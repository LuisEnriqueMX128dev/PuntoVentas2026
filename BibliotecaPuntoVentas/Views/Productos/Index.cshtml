@model BibliotecaPuntoVentas.ViewModels.Productos.ProductoIndexViewModel

@{
    ViewData["Title"] = "Productos";
    ViewData["PageTitle"] = "Productos";
    ViewData["PageSubtitle"] =
        "Administra tu catálogo de artículos";
}

<partial name="_Alertas" />

<div class="d-flex flex-column flex-lg-row
    align-items-lg-center
    justify-content-between
    gap-3 mb-4">

    <form method="get"
          asp-action="Index"
          class="d-flex flex-column flex-md-row gap-2 flex-grow-1">

        <div class="nova-search flex-grow-1">
            <input asp-for="Busqueda"
                   class="form-control nova-input"
                   placeholder="Buscar por nombre o código..." />
        </div>

        <select asp-for="CategoriaId"
                asp-items="Model.Categorias"
                class="form-select nova-input nova-filter">

            <option value="">
                Todas las categorías
            </option>
        </select>

        <select asp-for="Estatus"
                class="form-select nova-input nova-filter">

            <option value="">
                Todos los estados
            </option>

            <option value="true">
                Activos
            </option>

            <option value="false">
                Inactivos
            </option>
        </select>

        <button type="submit"
                class="btn btn-nova-secondary">
            Buscar
        </button>

        <a asp-action="Index"
           class="btn btn-nova-secondary">
            Limpiar
        </a>
    </form>

    <a asp-action="Crear"
       class="btn btn-nova-primary flex-shrink-0">
        + Nuevo producto
    </a>
</div>

<div class="nova-card">
    <div class="nova-card-header">
        <div>
            <h3>Catálogo de productos</h3>
            <p>
                @Model.Productos.Count producto(s) encontrado(s)
            </p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table nova-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Código</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Existencia</th>
                    <th>Estado</th>
                    <th class="text-end">
                        Acciones
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Productos.Any())
                {
                    foreach (var producto in Model.Productos)
                    {
                        <tr>
                            <td>
                                <div class="d-flex
                                    align-items-center
                                    gap-3">

                                    <div class="product-table-image">
                                        @if (!string.IsNullOrWhiteSpace(
                                                producto.UrlImagen))
                                        {
                                            <img src="@producto.UrlImagen"
                                                 alt="@producto.Nombre" />
                                        }
                                        else
                                        {
                                            <span>📦</span>
                                        }
                                    </div>

                                    <div>
                                        <strong>
                                            @producto.Nombre
                                        </strong>

                                        <small class="d-block
                                            text-secondary">
                                            Compra:
                                            @producto.PrecioCompra.ToString("C")
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @producto.Codigo
                            </td>

                            <td>
                                @producto.Categoria
                            </td>

                            <td>
                                <strong>
                                    @producto.PrecioVenta.ToString("C")
                                </strong>
                            </td>

                            <td>
                                @producto.Existencia
                            </td>

                            <td>
                                @if (!producto.Estatus)
                                {
                                    <span class="nova-status
                                        nova-status-inactive">
                                        Inactivo
                                    </span>
                                }
                                else if (producto.EstaAgotado)
                                {
                                    <span class="nova-status
                                        nova-status-danger">
                                        Agotado
                                    </span>
                                }
                                else if (producto.TieneStockBajo)
                                {
                                    <span class="nova-status
                                        nova-status-warning">
                                        Stock bajo
                                    </span>
                                }
                                else
                                {
                                    <span class="nova-status
                                        nova-status-success">
                                        Disponible
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex
                                    justify-content-end
                                    gap-2">

                                    <a asp-action="Editar"
                                       asp-route-id="@producto.Id"
                                       class="btn btn-sm
                                        btn-nova-secondary">
                                        Editar
                                    </a>

                                    <form asp-action="CambiarEstatus"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@producto.Id" />

                                        <button type="submit"
                                                class="btn btn-sm
                                            @(producto.Estatus
                                                ? "btn-outline-danger"
                                                : "btn-outline-success")">

                                            @(producto.Estatus
                                                ? "Desactivar"
                                                : "Activar")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="text-center py-5">

                            <div class="nova-empty">
                                <span>📦</span>

                                <h4>
                                    No se encontraron productos
                                </h4>

                                <p>
                                    Registra un producto para comenzar.
                                </p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>