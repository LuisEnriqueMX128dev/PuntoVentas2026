<header class="nova-topbar">
    <div class="d-flex align-items-center gap-3 min-w-0">
        <button type="button"
                class="nova-icon-button nova-menu-button"
                id="sidebarToggle"
                aria-label="Abrir menú">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>

        <div class="nova-page-heading min-w-0">
            <h1>@(ViewData["Title"] ?? "NovaPOS")</h1>
            <p>@(ViewData["Subtitle"] ?? "Sistema de punto de venta")</p>
        </div>
    </div>

    <div class="nova-topbar-actions">
        <div class="nova-date-box d-none d-md-flex">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                <path d="M16 3v4M8 3v4M3 11h18"></path>
            </svg>
            <span>@DateTime.Now.ToString("dd MMM yyyy")</span>
        </div>
    </div>
</header>